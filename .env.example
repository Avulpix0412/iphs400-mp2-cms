# Copy to .env (which is gitignored) and change the values.
# development or production; see "Production" in README.md
CMS_ENV=development
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE="大巴扎攻略站"
CMS_DATABASE=cms.db
# Development: the passwords of the demo accounts scripts/seed_demo.py creates
# (its Admin is always admin@example.test; CMS_ADMIN_EMAIL is not used).
# Production: CMS_ADMIN_EMAIL and CMS_ADMIN_PASSWORD are the first Admin's login
# (the password is temporary), made at startup while there is no Admin.
CMS_ADMIN_EMAIL=admin@example.test
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
# Uploaded images; defaults to a media/ folder next to the database
# CMS_MEDIA=media
